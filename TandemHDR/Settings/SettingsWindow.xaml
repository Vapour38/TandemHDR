<Window x:Class="TandemHdr.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:TandemHdr.Controls"
        xmlns:local="clr-namespace:TandemHdr.Settings"
        x:ClassModifier="internal"
        Title="Tandem HDR"
        Icon="pack://application:,,,/app.ico"
        Width="1100" Height="780"
        MinWidth="720" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFontFamily}">

    <!-- The caption is drawn below, but WindowChrome keeps the system's caption behaviour:
         CaptionHeight makes the top 40px draggable/snappable and double-click maximises. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <GridLength x:Key="LabelColumnWidth">250</GridLength>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="Tandem HDR" Style="{StaticResource CaptionTitleText}" />
                <TextBlock x:Name="DevBadge" Text="DEV BUILD" Visibility="Collapsed" FontWeight="SemiBold"
                           Style="{StaticResource CaptionTitleText}" Margin="10,0,0,0"
                           Foreground="{DynamicResource WarningForegroundBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}" Click="OnMinimiseClick"
                        ToolTip="Minimise">
                    <Path Data="M 0,0 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" />
                </Button>
                <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}" Click="OnMaximiseClick"
                        ToolTip="Maximise">
                    <Path x:Name="MaximiseGlyph" Data="M 0,0 H 10 V 10 H 0 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick"
                        ToolTip="Close">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource NavTabControl}"
                    Background="{DynamicResource SurfaceBrush}"
                    Loaded="OnTabsLoaded" SelectionChanged="OnTabsSelectionChanged">

            <TabItem Header="Settings" Style="{StaticResource NavTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <!-- One left edge for everything: the 12px matches the row bands' own
                         padding, so headings, checkboxes and band contents line up. -->
                    <StackPanel Margin="24,20,24,24">

                        <!-- Status readout -->
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                            <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDot}" Margin="0,0,10,0" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource ForegroundPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusDetailText" Style="{StaticResource SecondaryText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Shown until both profiles are set: without them the app toggles
                             HDR and nothing else, which looks like it is not working. -->
                        <Border x:Name="SetupBanner" Style="{StaticResource RowBand}"
                                Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Finish setting up" Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource ForegroundPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SetupBannerText" Style="{StaticResource SecondaryText}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Colour profiles" Style="{StaticResource SectionHeading}" />

                        <Border Style="{StaticResource RowBand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="SDR profile" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Used while HDR is off" Style="{StaticResource SecondaryText}"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="SdrWarningText" Style="{StaticResource SecondaryText}"
                                               Foreground="{DynamicResource WarningForegroundBrush}"
                                               Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="SdrProfileCombo" Grid.Column="1"
                                          Style="{StaticResource ProfileComboBox}"
                                          VerticalAlignment="Center" MaxDropDownHeight="320"
                                          AutomationProperties.Name="SDR profile"
                                          SelectionChanged="OnSdrProfileSelected" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowBand}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="HDR profile" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Used while HDR is on" Style="{StaticResource SecondaryText}"
                                               Margin="0,2,0,0" />
                                    <TextBlock x:Name="HdrWarningText" Style="{StaticResource SecondaryText}"
                                               Foreground="{DynamicResource WarningForegroundBrush}"
                                               Margin="0,2,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="HdrProfileCombo" Grid.Column="1"
                                          Style="{StaticResource ProfileComboBox}"
                                          VerticalAlignment="Center" MaxDropDownHeight="320"
                                          AutomationProperties.Name="HDR profile"
                                          SelectionChanged="OnHdrProfileSelected" />
                            </Grid>
                        </Border>

                        <TextBlock Text="General" Style="{StaticResource SectionHeading}" />

                        <StackPanel Margin="12,0,0,0">
                            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource SettingsCheckBox}"
                                      Content="Start with Windows" Margin="0,0,0,12"
                                      Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled" />
                            <CheckBox x:Name="SyncExternalCheck" Style="{StaticResource SettingsCheckBox}"
                                      Content="Switch profiles when HDR is turned on or off outside Tandem HDR"
                                      Margin="0,0,0,12"
                                      Checked="OnSyncExternalToggled" Unchecked="OnSyncExternalToggled" />
                            <CheckBox x:Name="NotificationsCheck" Style="{StaticResource SettingsCheckBox}"
                                      Content="Show a notification when the profile switches"
                                      Checked="OnNotificationsToggled" Unchecked="OnNotificationsToggled" />
                        </StackPanel>

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeading}" />

                        <CheckBox x:Name="UpdateOnStartCheck" Style="{StaticResource SettingsCheckBox}"
                                  Content="Check for updates when Tandem HDR starts" Margin="12,0,0,12"
                                  Checked="OnUpdateOnStartToggled" Unchecked="OnUpdateOnStartToggled" />

                        <Border Margin="12,0,12,0">
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="UpdateDetailText" Style="{StaticResource SecondaryText}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="UpdateActionButton" Content="Check now"
                                            Style="{StaticResource SecondaryButton}"
                                            MinWidth="140"
                                            Click="OnUpdateActionClick" />
                                    <Button x:Name="SkipVersionButton" Content="Skip this version"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0" Visibility="Collapsed"
                                            Click="OnSkipVersionClick" />
                                </StackPanel>

                                <!-- What actually changed, straight from the release. Capped
                                     rather than free-growing: notes can run long and this row
                                     is not the point of the window. -->
                                <Border x:Name="UpdateNotesPanel" Visibility="Collapsed"
                                        Margin="0,12,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="UpdateNotesText" Style="{StaticResource SecondaryText}"
                                                   TextWrapping="Wrap" Margin="0,0,12,0" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Programs" Style="{StaticResource NavTabItem}">
                <local:ProgramsPanel x:Name="ProgramsPanel" />
            </TabItem>

            <TabItem Header="About" Style="{StaticResource NavTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="24,20,24,24">

                        <!-- Plain centred identity block, as an About page usually is. -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,16,0,40">
                            <Image Source="pack://application:,,,/app.ico" Width="64" Height="64"
                                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Tandem HDR" HorizontalAlignment="Center" Margin="0,14,0,0"
                                       Style="{StaticResource BodyText}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimaryBrush}" />
                            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Style="{StaticResource BodyText}" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Switches HDR on and off, and keeps your colour profile in step." />
                            <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Style="{StaticResource BodyText}">
                                <Hyperlink NavigateUri="https://github.com/Vapour38/TandemHDR"
                                           RequestNavigate="OnSourceLinkNavigate"
                                           Foreground="{DynamicResource CheckAccentBrush}">Source code on GitHub</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="Copyright © 2026 Lachlan Dennis. MIT License." HorizontalAlignment="Center"
                                       Margin="0,16,0,0" Style="{StaticResource SecondaryText}" />
                        </StackPanel>

                        <!-- One action with no heading of its own, kept off the Settings tab. -->
                        <Border Margin="12,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Remove Tandem HDR" Style="{StaticResource BodyText}" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Text="Deletes its settings, start-up entry and Start Menu shortcut, then closes. You choose whether to keep your colour profiles." />
                                <Button x:Name="RemoveDataButton" Content="Remove…"
                                        Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="140"
                                        Click="OnRemoveDataClick" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
